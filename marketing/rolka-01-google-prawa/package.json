  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc",
    "compose:audio": "python3 scripts/compose_audio.py",
    "render:raw": "remotion render GrovBaseRolka01 out/_render_raw.mp4 --gl=swiftshader --codec=h264 --crf=17 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k --jpeg-quality=95 --x264-preset=slow",
    "master": "bash scripts/master.sh",
    "render": "npm run render:raw && npm run master",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade"
  },
  "allowScripts": {
    "esbuild": false
  }
