# Public (safe for browser — anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical origin of this deployment — the one host the app uses for auth
# e-mail links, canonical tags, OpenGraph and the sitemap. Production is
# https://grovbase.com. Leave unset locally: lib/site.ts falls back to
# http://localhost:3000 in development and to the Vercel URL on previews.
# NEXT_PUBLIC_SITE_URL=https://grovbase.com

# Server-only. NEVER expose with NEXT_PUBLIC_. Not required for current features.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# FAL_API_KEY=
