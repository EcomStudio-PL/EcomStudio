# Public (safe for browser — anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical origin of this deployment — the one host the app uses for auth
# e-mail links, canonical tags, OpenGraph and the sitemap. Production is
# https://grovbase.com. Leave unset locally: lib/site.ts falls back to
# http://localhost:3000 in development and to the Vercel URL on previews.
# NEXT_PUBLIC_SITE_URL=https://grovbase.com

# Server-only. Encrypts every credential the admin panel stores — AI provider
# keys, the mailbox password, the Telegram bot token. 32 bytes as 64 hex chars:
#   openssl rand -hex 32
# Losing or changing it does not break the app, but every stored secret has to
# be typed in again, so keep it somewhere you can find it.
# APP_ENCRYPTION_KEY=

# Server-only, optional. A SEPARATE key for the Poczta and Telegram integrations
# only; without it they fall back to APP_ENCRYPTION_KEY, which is a perfectly
# good setup. If you do want a dedicated key, set it BEFORE typing the mailbox
# password and the bot token — a key added afterwards cannot read what the old
# one encrypted, and the panel will ask for those two secrets again.
# GROVBASE_INTEGRATIONS_ENCRYPTION_KEY=

# Server-only, optional. Vercel Cron sends this as "Authorization: Bearer <value>"
# when it calls /api/cron/mail. Until it is set, the scheduled mailbox check is
# refused (401) and only the admin's "Sprawdź nowe wiadomości" button polls the
# inbox — the endpoint is never open to anonymous callers either way.
#   openssl rand -hex 32
# CRON_SECRET=

# Server-only. NEVER expose with NEXT_PUBLIC_. Not required for current features.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# FAL_API_KEY=
